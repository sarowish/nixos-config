blur {
    passes 2
    offset 3.0
    noise 0.02
    saturation 1.0
}

layer-rule {
    match namespace="notifications"
    match namespace="rofi"
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^ags-window-map-tile$"
    geometry-corner-radius 1
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^ags-(calendar|world-clocks|player|volume-(osd-)?(track|sink)|wallpaper-(picker|preview-controls|color-picker|preview-background))$"
    geometry-corner-radius 20
    shadow {
        on
        softness 16
        spread 0
        offset x=0 y=4
        color "#0000004d"
    }
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^ags-(player|volume-(osd-)?track|wallpaper-color-picker)$"
    geometry-corner-radius 14
}

layer-rule {
    match namespace="^ags-wallpaper-preview-(background|strip|handle)$"
    geometry-corner-radius 0
    shadow {
        off
    }
}

layer-rule {
    match namespace="^ags-wallpaper-preview-(strip|handle)$"
    background-effect {
        blur false
    }
}

layer-rule {
    match namespace="^ags-volume-(osd-)?sink$"
    geometry-corner-radius 12
}

window-rule {
    background-effect {
        blur true
        xray false
    }
}
