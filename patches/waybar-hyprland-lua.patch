+bool IPC::isLuaProtocol() {
+  if (s_luaProtocolDetected_.has_value()) {
+    return *s_luaProtocolDetected_;
+  }
+
+  bool luaProtocol = false;
+  try {
+    util::JsonParser parser;
+    const Json::Value version = parser.parse(getSocket1Reply("j/version"));
+
+    std::string versionString = version["version"].asString();
+    if (versionString.empty()) {
+      versionString = version["tag"].asString();
+    }
+
+    const size_t firstDigit = versionString.find_first_of("0123456789");
+    if (firstDigit != std::string::npos) {
+      const int major = std::stoi(versionString.substr(firstDigit));
+      int minor = 0;
+      const size_t dot = versionString.find('.', firstDigit);
+      if (dot != std::string::npos && dot + 1 < versionString.size()) {
+        minor = std::stoi(versionString.substr(dot + 1));
+      }
+      luaProtocol = major > 0 || (major == 0 && minor >= 54);
+    } else {
+      spdlog::warn("Hyprland IPC: could not parse version '{}', assuming legacy protocol",
+                   versionString);
+    }
+  } catch (const std::exception& error) {
+    spdlog::warn("Hyprland IPC: version detection failed ({}), assuming legacy protocol",
+                 error.what());
+  }
+
+  if (luaProtocol) {
+    spdlog::info("Hyprland IPC: detected Lua-based dispatch protocol");
+  } else {
+    spdlog::info("Hyprland IPC: detected legacy dispatch protocol");
+  }
+
+  s_luaProtocolDetected_ = luaProtocol;
+  return luaProtocol;
+}
+
+std::string IPC::buildLuaDispatch(const std::string& dispatcher,
+                                  const std::string& arg) {
+  if (dispatcher == "workspace") {
+    return "/dispatch hl.dsp.focus({ workspace = \"" + arg + "\" })";
+  }
+  if (dispatcher == "focusworkspaceoncurrentmonitor") {
+    return "/dispatch hl.dsp.focus({ workspace = \"" + arg +
+           "\", on_current_monitor = true })";
+  }
+  if (dispatcher == "togglespecialworkspace") {
+    if (arg.empty()) {
+      return "/dispatch hl.dsp.workspace.toggle_special()";
+    }
+    return "/dispatch hl.dsp.workspace.toggle_special(\"" + arg + "\")";
+  }
+
+  spdlog::warn("Hyprland IPC: unknown dispatcher '{}' in Lua mode", dispatcher);
+  return "/dispatch hl.dsp." + dispatcher + "(\"" + arg + "\")";
+}
+
+std::string IPC::dispatch(const std::string& dispatcher, const std::string& arg) {
+  if (isLuaProtocol()) {
+    return getSocket1Reply(buildLuaDispatch(dispatcher, arg));
+  }
+
+  std::string command = "dispatch " + dispatcher;
+  if (!arg.empty()) {
+    command += " " + arg;
+  }
+  return getSocket1Reply(command);
+}
+
 }  // namespace waybar::modules::hyprland
